{%- comment -%}
  Enhanced Lazy Loading Image Snippet
  
  Usage:
  {% render 'lazy-image', 
    image: image_object,
    sizes: '100vw',
    widths: '400,800,1200',
    class: 'custom-class',
    alt: 'Alt text',
    loading: 'lazy' or 'eager',
    priority: true/false
  %}
{%- endcomment -%}

{%- liquid
  assign image = image | default: nil
  assign sizes = sizes | default: '100vw'
  assign widths = widths | default: '400,800,1200'
  assign class = class | default: ''
  assign alt = alt | default: image.alt | escape
  assign loading = loading | default: 'lazy'
  assign priority = priority | default: false
  
  if priority
    assign loading = 'eager'
  endif
  
  if image
    assign image_url = image | image_url: width: image.width
    assign image_srcset = image | image_url: width: image.width | append: ' 1x'
    
    # Generate srcset for different widths
    assign width_array = widths | split: ','
    assign srcset_parts = ''
    
    for width in width_array
      assign width_num = width | plus: 0
      if width_num <= image.width
        assign resized_image = image | image_url: width: width_num
        assign srcset_parts = srcset_parts | append: resized_image | append: ' ' | append: width | append: 'w'
        unless forloop.last
          assign srcset_parts = srcset_parts | append: ', '
        endunless
      endif
    endfor
  endif
-%}

{%- if image -%}
  <img 
    src="{{ image_url }}"
    {% if srcset_parts != blank %}srcset="{{ srcset_parts }}"{% endif %}
    sizes="{{ sizes }}"
    alt="{{ alt }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    loading="{{ loading }}"
    decoding="async"
    class="{{ class }}"
    {% if loading == 'lazy' %}data-lazy-src="{{ image_url }}"{% endif %}
    style="{% if loading == 'lazy' %}opacity: 0; transition: opacity 0.3s ease-in-out;{% endif %}"
    onload="{% if loading == 'lazy' %}this.style.opacity='1';{% endif %}"
  >
{%- else -%}
  <div class="{{ class }} lazy-placeholder" style="background: #f0f0f0; min-height: 200px; display: flex; align-items: center; justify-content: center;">
    <span style="color: #999; font-size: 14px;">Image not available</span>
  </div>
{%- endif -%} 